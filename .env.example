# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Secrets are read only via os.environ.get(...) — never hardcoded in source.

# LLM provider
ANTHROPIC_API_KEY=your-anthropic-key-here

# Web search provider (Tavily default; DuckDuckGo fallback needs no key)
TAVILY_API_KEY=your-tavily-key-here
