# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Secrets are read only via os.environ.get(...) — never hardcoded in source.

# LLM provider: Google Gemini (Developer API / AI Studio)
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional Google Cloud / Vertex AI context (only if GOOGLE_GENAI_USE_VERTEXAI=true)
GEMINI_APP_NAME=HW2
GOOGLE_CLOUD_PROJECT=projects/000000000000
GOOGLE_CLOUD_PROJECT_NUMBER=000000000000
GOOGLE_GENAI_USE_VERTEXAI=false

# Web search provider (DuckDuckGo fallback needs no key)
TAVILY_API_KEY=your-tavily-key-here
